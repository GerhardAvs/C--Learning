{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar archivo actual a /build",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-g",
                "${file}",
                "-o",
                "${workspaceFolder}/build/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "options": {
                    "shell": {
                        "executable": "cmd.exe",
                        "args": ["/c", "if not exist build mkdir build &&"]
                    }
                }
            },
            "linux": {
                "command": "sh",
                "args": [
                    "-c",
                    "mkdir -p ${workspaceFolder}/build && g++ -std=c++17 -g ${file} -o ${workspaceFolder}/build/${fileBasenameNoExtension}"
                ]
            },
            "osx": {
                "command": "sh",
                "args": [
                    "-c",
                    "mkdir -p ${workspaceFolder}/build && g++ -std=c++17 -g ${file} -o ${workspaceFolder}/build/${fileBasenameNoExtension}"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}